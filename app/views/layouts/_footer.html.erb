<footer class="site-footer">
  <div class="container">
    <div class="site-footer__main">
      <div class="site-footer__identity">
        <%= link_to root_path, class: "site-footer__brand", data: { turbo: false } do %>
          <%= image_tag(dev_images("full-logo.png"), alt: "ArogyaM Wellness Center", width: 184, class: "site-footer__logo") %>
        <% end %>
        <p>Traditional Ayurveda and Yoga, practised with care in the quiet landscape of Sacred Grove.</p>
        <p class="site-footer__place">Chowdepalli · Andhra Pradesh · India</p>
      </div>

      <nav class="site-footer__nav" aria-label="Footer navigation">
        <div>
          <h2>Discover</h2>
          <%= link_to "Health programmes", programmes_path %>
          <%= link_to "Accommodation", accommodation_path %>
          <%= link_to "Testimonials", testimonials_path %>
          <%= link_to "Donate", donate_path %>
          <%= link_to "Gallery", gallery_index_path %>
        </div>
        <div>
          <h2>ArogyaM</h2>
          <%= link_to "Our story", about_path %>
          <%= link_to "Journal", blogs_path %>
          <%= link_to "Contact", contacts_path %>
          <%= link_to "Privacy", privacy_policy_path %>
          <%= link_to "Cookie policy", cookie_policy_path %>
          <button type="button" class="site-footer__link-button" data-action="cookie-consent#open">Cookie settings</button>
        </div>
      </nav>

      <div class="site-footer__contact">
        <p class="site-footer__eyebrow">Plan your stay</p>
        <a href="tel:+918333981305">+91 8333 981 305</a>
        <a href="mailto:admin@arogyam.life">admin@arogyam.life</a>
        <%= link_to "Make an enquiry", contacts_path, class: "site-footer__cta" %>
      </div>
    </div>

    <div class="site-footer__base">
      <p>© ArogyaM, <%= Time.current.year %></p>
      <%= link_to "A unit of The Satsang Foundation", "https://satsang-foundation.org", target: "_blank", rel: "noopener" %>
    </div>
  </div>
</footer>
