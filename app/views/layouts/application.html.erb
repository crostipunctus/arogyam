<!DOCTYPE html>
<html lang="en">
  <head>
    <%= display_meta_tags(default_meta_tags) %>
    <%= favicon_link_tag asset_path('favicon.ico') %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">
    <link rel="preconnect" href="https://d1w11gv0j27jrz.cloudfront.net">

    <%# A restrained editorial pairing: one serif and one humanist sans. %>
    <% google_fonts_url = "https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,400;0,500;0,600;1,400&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" %>
    <link rel="stylesheet" href="<%= google_fonts_url %>">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9.1.0/swiper-bundle.min.css">
    <link rel="stylesheet" href="/fancybox.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <script nonce="<%= content_security_policy_nonce %>">
      const arogyaMConsentStorageKey = "arogyam_cookie_consent_v1";
      const arogyaMAnalyticsId = "G-JLQGEBVGRW";

      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };

      window.arogyamAnalyticsAllowed = function() {
        try {
          return window.localStorage.getItem(arogyaMConsentStorageKey) === "accepted";
        } catch (_error) {
          return false;
        }
      };

      function arogyaMConsentState(analyticsGranted) {
        return {
          analytics_storage: analyticsGranted ? "granted" : "denied",
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied"
        };
      }

      window.gtag("consent", "default", arogyaMConsentState(window.arogyamAnalyticsAllowed()));
      window.gtag("set", "ads_data_redaction", true);

      window.loadArogyaMAnalytics = function() {
        if (document.querySelector("script[data-arogyam-analytics]")) return;

        window.gtag("js", new Date());
        window.gtag("config", arogyaMAnalyticsId, {
          allow_google_signals: false,
          allow_ad_personalization_signals: false
        });

        const analyticsScript = document.createElement("script");
        analyticsScript.async = true;
        analyticsScript.src = `https://www.googletagmanager.com/gtag/js?id=${arogyaMAnalyticsId}`;
        analyticsScript.dataset.arogyamAnalytics = "true";
        document.head.appendChild(analyticsScript);
      };

      window.setArogyaMAnalyticsConsent = function(analyticsGranted) {
        window.gtag("consent", "update", arogyaMConsentState(analyticsGranted));
        if (analyticsGranted) window.loadArogyaMAnalytics();
      };

      if (window.arogyamAnalyticsAllowed()) window.loadArogyaMAnalytics();
    </script>

    <%= render 'layouts/json_ld' %>
  </head>
  <body class="site-body controller-<%= controller.controller_name %> action-<%= controller.action_name %>"
        data-controller="cookie-consent"
        data-cookie-consent-storage-key-value="arogyam_cookie_consent_v1">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div id="analytics-events"><%= ga_conversion_tag %></div>
    <%= render 'layouts/navbar' %>
      <main class="page-wrapper" id="main-content">

        <% notification_type = flash[:notice].present? ? "success" : (flash[:alert].present? ? "error" : "") %>
        <div data-controller="notification" data-notification-type-value="<%= notification_type %>" class="notification">
          <div data-notification-target="message"><%= flash[:notice].presence || flash[:alert].presence %></div>
        </div>


        <%= yield %>

      </main>

      <%= render 'layouts/footer' %>
      <%= render 'shared/whatsapp_button' %>
      <%= render 'shared/cookie_consent' %>
  </body>
</html>
