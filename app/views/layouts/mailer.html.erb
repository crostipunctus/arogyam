<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <title>ArogyaM</title>
    <!--[if mso]>
    <style type="text/css">body, table, td { font-family: Arial, sans-serif !important; }</style>
    <![endif]-->
  </head>
  <body style="margin:0; padding:0; background-color:#faf7f2; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; color:#2c3e2d; -webkit-font-smoothing:antialiased;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#faf7f2; padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; background-color:#ffffff; border:1px solid #e8e4dc; border-radius:6px; overflow:hidden;">
            <tr>
              <td align="center" style="padding:32px 24px 16px 24px; background-color:#ffffff; border-bottom:1px solid #e8e4dc;">
                <%= image_tag("#{Rails.application.credentials.cloudfront[:host]}/big-logo.png", alt: 'ArogyaM', width: 160, style: 'display:block; border:0; outline:none; max-width:160px; height:auto;') %>
              </td>
            </tr>
            <tr>
              <td style="padding:32px 32px 24px 32px; font-size:16px; line-height:1.6; color:#2c3e2d;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td style="padding:24px 32px 32px 32px; background-color:#faf7f2; border-top:1px solid #e8e4dc; font-size:13px; line-height:1.6; color:#6b6b6b; text-align:center;">
                <p style="margin:0 0 8px 0;">
                  <strong style="color:#448c74;">ArogyaM</strong> &middot; Sacred Grove, Chowdepalli
                </p>
                <p style="margin:0 0 8px 0;">
                  <a href="https://www.arogyam.life" style="color:#448c74; text-decoration:none;">arogyam.life</a>
                  &nbsp;&middot;&nbsp;
                  <a href="mailto:admin@arogyam.life" style="color:#448c74; text-decoration:none;">admin@arogyam.life</a>
                </p>
                <p style="margin:0; color:#9a9a9a; font-size:12px;">
                  A Unit of The Satsang Foundation
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
