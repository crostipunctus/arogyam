<% start_date = @vishraam_registration.date %>
<% duration = @vishraam_registration.duration %>
<% end_date = start_date.present? ? start_date + duration.to_i.days : nil %>

<h1 style="margin:0 0 16px 0; font-size:24px; line-height:1.3; color:#2c3e2d; font-weight:600;">
  You're registered for VishraM, <%= @vishraam_registration.user.first_name %>.
</h1>
<p style="margin:0 0 24px 0; font-size:16px; line-height:1.6; color:#2c3e2d;">
  Thank you for registering for VishraM at ArogyaM. Here are your details:
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px 0; background-color:#faf7f2; border:1px solid #e8e4dc; border-radius:4px;">
  <tr>
    <td style="padding:16px 20px; border-bottom:1px solid #e8e4dc; font-size:14px; color:#6b6b6b;">Programme</td>
    <td style="padding:16px 20px; border-bottom:1px solid #e8e4dc; font-size:15px; color:#2c3e2d; font-weight:500; text-align:right;">VishraM</td>
  </tr>
  <tr>
    <td style="padding:16px 20px; border-bottom:1px solid #e8e4dc; font-size:14px; color:#6b6b6b;">Start date</td>
    <td style="padding:16px 20px; border-bottom:1px solid #e8e4dc; font-size:15px; color:#2c3e2d; font-weight:500; text-align:right;">
      <% if start_date.present? %>
        <%= start_date.strftime("%B #{start_date.day.ordinalize}, %Y") %> at 10 a.m.
      <% else %>
        Not set
      <% end %>
    </td>
  </tr>
  <tr>
    <td style="padding:16px 20px; border-bottom:1px solid #e8e4dc; font-size:14px; color:#6b6b6b;">Duration</td>
    <td style="padding:16px 20px; border-bottom:1px solid #e8e4dc; font-size:15px; color:#2c3e2d; font-weight:500; text-align:right;"><%= duration %> days</td>
  </tr>
  <% if end_date.present? %>
  <tr>
    <td style="padding:16px 20px; border-bottom:1px solid #e8e4dc; font-size:14px; color:#6b6b6b;">End date</td>
    <td style="padding:16px 20px; border-bottom:1px solid #e8e4dc; font-size:15px; color:#2c3e2d; font-weight:500; text-align:right;">
      <%= end_date.strftime("%B #{end_date.day.ordinalize}, %Y") %> at 11 a.m.
    </td>
  </tr>
  <% end %>
  <tr>
    <td style="padding:16px 20px; font-size:14px; color:#6b6b6b;">Cost</td>
    <td style="padding:16px 20px; font-size:15px; color:#2c3e2d; font-weight:600; text-align:right;"><%= @vishraam_registration.formatted_cost %></td>
  </tr>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px 0; background-color:#fff8e6; border-left:3px solid #d4a44a; border-radius:4px;">
  <tr>
    <td style="padding:14px 18px; font-size:14px; line-height:1.5; color:#6b5520;">
      <strong>Please make the payment in advance</strong> to confirm your slot.
    </td>
  </tr>
</table>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px 0;">
  <tr>
    <td style="background-color:#448c74; border-radius:4px;">
      <a href="https://www.arogyam.life" style="display:inline-block; padding:12px 28px; color:#ffffff; text-decoration:none; font-weight:500; font-size:15px;">Manage Registration</a>
    </td>
  </tr>
</table>

<p style="margin:0; font-size:14px; line-height:1.6; color:#6b6b6b;">
  Questions? Reply to this email or write to
  <a href="mailto:admin@arogyam.life" style="color:#448c74; text-decoration:none;">admin@arogyam.life</a>.
</p>
