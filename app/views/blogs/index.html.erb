<% set_meta_tags title: 'Blog',
                 description: 'Read articles on Ayurveda, yoga, wellness, and holistic health from ArogyaM Wellness Center.' %>

<%= render "shared/page_header",
           eyebrow: "The ArogyaM journal",
           title: "Notes on wellbeing",
           description: "Seasonal Ayurvedic guidance, practices for daily life, and stories from Sacred Grove." %>

<div class="container page-section journal-page">

  <% if @blogs.empty? %>
    <div class="journal-empty text-center p-4 mb-4">
      <p class="eyebrow">In preparation</p>
      <h2>Our journal is coming soon.</h2>
      <p>We are gathering thoughtful notes on Ayurveda, Yoga, and life at Sacred Grove.</p>
    </div>
  <% end %>

  <% if current_user_admin? %>
    <div class="admin">
      <%= link_to "New post", new_blog_path, class: "btn btn-outline-success btn-sm" %>
    </div>
  <% end %>

  <!-- Post-->
 <div class="container-custom mx-auto">
    <article class="row g-0 border-0 mb-4">
        <% @blogs.each do |blog| %>
            <div class="blog-item">
              <div class="col-sm-12 col-lg-12 d-flex">
                  <div class=" flex-grow-1">
                      <h3><%= link_to blog.title.capitalize, blog_path(blog) %></h3>
                      <% if blog.subtitle.present? %>
                        <h5 class="mb-3"><%= blog.subtitle %></h5>
                      <% else %>
                        <p class="fs-lg mb-3"><%= blog.content.to_plain_text.truncate(100) %></p>
                      <% end %>

                  </div>
                  <% if blog.image.attached? %>
                      <div class="align-self-center">
                          <%= image_tag(rails_public_blob_url(blog.image.variant(:thumb)), class: "blog-index-images img-fluid rounded mb-4", alt: "#{blog.title} - ArogyaM blog", loading: "lazy") %>
                      </div>
                  <% end %>
              </div>
              <div class="col-sm-12 text-muted fs-sm mb-5">
                  <%= blog.created_at.strftime("%d %b %y %H:%M") %>
              </div>

                <% if current_user_admin? %>
                  <div class="admin">
                    <%= link_to "Edit", edit_blog_path(blog), class: "btn btn-outline-success btn-sm" %>
                  </div>
                  <div class="admin">
                    <%= link_to "Delete", blog_path(blog), method: :delete, data: {turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-outline-danger btn-sm" %>
                  </div>
                <% end %>
              
            </div>
        <% end %>
    </article>
</div>

</div>
