<%= page_title 'Registration Confirmation' %>

<section class="container py-5 mt-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">

      <% if flash[:notice] %>
        <div class="alert alert-success d-flex align-items-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-check-circle-fill flex-shrink-0 me-2" viewBox="0 0 16 16"><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/></svg>
          <div><%= flash[:notice] %></div>
        </div>
        <% flash.delete(:notice) %>
      <% end %>

      <%# Progress Steps (only for non-admin users viewing their own registration) %>
      <% unless current_user_admin? %>
        <div class="registration-steps mb-5">
          <div class="d-flex justify-content-center align-items-center">
            <div class="step-item completed">
              <div class="step-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z"/></svg>
              </div>
              <div class="step-label">Fill Details</div>
            </div>
            <div class="step-line completed"></div>
            <div class="step-item completed">
              <div class="step-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z"/></svg>
              </div>
              <div class="step-label">Review</div>
            </div>
            <div class="step-line completed"></div>
            <div class="step-item completed">
              <div class="step-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z"/></svg>
              </div>
              <div class="step-label">Confirmed</div>
            </div>
          </div>
        </div>
      <% end %>

      <h2 class="text-center mb-4 registration-page-title">Registration #<%= @registration.id %></h2>

      <%# Programme Details Card %>
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-section-title mb-3">Programme Details</h5>
          <div class="row g-3">
            <div class="col-sm-6">
              <div class="review-detail">
                <div class="review-label">Programme</div>
                <div class="review-value"><%= @registration.package.name %></div>
              </div>
            </div>
            <% if @registration.package.name == "VishraM" || @registration.package.name == "ShamanaM" %>
              <div class="col-sm-6">
                <div class="review-detail">
                  <div class="review-label">Duration</div>
                  <div class="review-value"><%= @registration.duration %> days</div>
                </div>
              </div>
            <% end %>
            <div class="col-sm-6">
              <div class="review-detail">
                <div class="review-label">Start Date</div>
                <div class="review-value"><%= formatted_date_with_year(@registration.start_date) %></div>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="review-detail">
                <div class="review-label">Registered On</div>
                <div class="review-value"><%= formatted_created_at_date(@registration.created_at.to_s) %></div>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="review-detail">
                <div class="review-label">Status</div>
                <div class="review-value">
                  <span class="badge rounded-pill bg-<%= registration_status_badge_class(@registration.status) %>"><%= @registration.status %></span>
                </div>
              </div>
            </div>
            <% if @registration.cancelled %>
              <div class="col-sm-6">
                <div class="review-detail">
                  <div class="review-label">Cancelled</div>
                  <div class="review-value"><span class="badge rounded-pill bg-danger">Yes</span></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <% if current_user_admin? %>
        <% user_profile = @registration.user.user_profile %>
        <%# Participant Info Card %>
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body p-4">
            <h5 class="card-section-title mb-3">Participant Information</h5>
            <div class="row g-3">
              <div class="col-sm-6">
                <div class="review-detail">
                  <div class="review-label">Full Name</div>
                  <div class="review-value"><%= link_to user_full_name(@registration.user), user_profile_path(user_id: @registration.user.id) %></div>
                </div>
              </div>
              <div class="col-sm-6">
                <div class="review-detail">
                  <div class="review-label">Email</div>
                  <div class="review-value"><%= @registration.user.email %></div>
                </div>
              </div>
              <% if user_profile.present? %>
                <div class="col-sm-6">
                  <div class="review-detail">
                    <div class="review-label">Gender</div>
                    <div class="review-value"><%= user_profile.gender.presence || 'Not provided' %></div>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="review-detail">
                    <div class="review-label">Date of Birth</div>
                    <div class="review-value"><%= user_profile.date_of_birth.present? ? formatted_date_of_birth(user_profile.date_of_birth.to_s) : 'Not provided' %></div>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="review-detail">
                    <div class="review-label">Phone</div>
                    <div class="review-value"><%= user_profile.phone_number.presence || 'Not provided' %></div>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="review-detail">
                    <div class="review-label">Occupation</div>
                    <div class="review-value"><%= user_profile.occupation.presence || 'Not provided' %></div>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="review-detail">
                    <div class="review-label">Marital Status</div>
                    <div class="review-value"><%= user_profile.marital_status.presence || 'Not provided' %></div>
                  </div>
                </div>
                <div class="col-12">
                  <div class="review-detail">
                    <div class="review-label">Address</div>
                    <div class="review-value">
                      <%= user_profile.address.presence || 'Not provided' %><br>
                      <%= [user_profile.city, user_profile.country, user_profile.zip].select(&:present?).join(', ').presence || 'Not provided' %>
                    </div>
                  </div>
                </div>
              <% else %>
                <div class="col-12">
                  <div class="alert alert-warning mb-0">
                    This participant has not completed their profile yet.
                  </div>
                </div>
              <% end %>
              <% if @registration.comments.present? %>
                <div class="col-12">
                  <div class="review-detail">
                    <div class="review-label">Comments</div>
                    <div class="review-value"><%= @registration.comments %></div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <%# Health Information Card %>
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body p-4">
            <h5 class="card-section-title mb-3">Health Information</h5>
            <div class="row g-3">
              <div class="col-12">
                <div class="review-detail">
                  <div class="review-label">Substance Use</div>
                  <div class="review-value"><%= @registration.substances %></div>
                </div>
              </div>
              <div class="col-12">
                <div class="review-detail">
                  <div class="review-label">Medical Conditions</div>
                  <div class="review-value"><%= @registration.health_conditions %></div>
                </div>
              </div>
              <div class="col-12">
                <div class="review-detail">
                  <div class="review-label">Lifestyle</div>
                  <div class="review-value"><%= @registration.lifestyle %></div>
                </div>
              </div>
              <div class="col-12">
                <div class="review-detail">
                  <div class="review-label">Medication</div>
                  <div class="review-value"><%= @registration.medication %></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="d-flex gap-2">
          <%= link_to 'Back to Registrations', registrations_path, class: "btn btn-outline-primary rounded-pill px-4" %>
          <%= link_to 'Edit Comments', edit_registration_path(@registration), class: "btn btn-outline-secondary rounded-pill px-4" %>
        </div>
      <% else %>
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body p-4 text-center">
            <p class="mb-1">A confirmation email has been sent to <strong><%= @registration.user.email %></strong>.</p>
            <p class="text-muted mb-0">Our team will review your registration and get back to you shortly.</p>
          </div>
        </div>
        <%= link_to 'View Programmes', programmes_path, class: "btn btn-primary rounded-pill px-4" %>
      <% end %>
    </div>
  </div>
</section>
