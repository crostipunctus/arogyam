<%= page_title 'Registrations' %>

<section class="container py-5 mt-4">
  <%# Header %>
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
      <h1 class="registration-page-title mb-1">Registrations</h1>
      <p class="text-muted mb-0">Manage programme registrations</p>
    </div>
    <div class="d-flex gap-2 mt-2 mt-md-0">
      <%= link_to 'Export Excel', pdf_registrations_path(format: :xlsx), class: 'btn btn-outline-primary rounded-pill px-3' %>
      <%= link_to 'Export VishraM', export_vishraam_registrations_path(format: :xlsx), class: 'btn btn-outline-secondary rounded-pill px-3' %>
    </div>
  </div>

  <%# Filter Bar %>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3 px-4">
      <%= form_with url: registrations_path, method: :get, data: { turbo_frame: "registrations_table", controller: "form", action: "change->form#submit" } do |form| %>
        <div class="d-flex flex-wrap align-items-center gap-3">
          <label class="form-label fw-medium mb-0 text-nowrap">Filter by:</label>
          <%= form.select :filter,
              [
                ['Upcoming', 'upcoming'],
                ['Completed', 'completed'],
                ['Payment Complete', 'payment_complete'],
                ['Payment Pending', 'payment_pending'],
                ['Cancelled', 'cancelled'],
                ['All Registrations', 'all']
              ],
              { selected: params[:filter] || 'upcoming' },
              class: "form-select form-select-sm", style: "max-width: 220px;" %>
        </div>
      <% end %>
    </div>
  </div>

  <%= render 'registrations' %>
</section>
