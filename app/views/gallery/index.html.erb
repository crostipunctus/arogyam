<% set_meta_tags title: 'Gallery',
                 description: 'Explore the landscape, rooms, gardens, and daily life at ArogyaM Wellness Center in Sacred Grove, Chowdepalli.' %>

<%= render "shared/page_header",
           eyebrow: "Sacred Grove in pictures",
           title: "A sense of place",
           description: "Quiet corners, healing spaces, and the natural landscape surrounding ArogyaM." %>

<section class="container page-section gallery-page">
  <div class="galleryIndex">
    <div class="galleryImages">
      <% if @images.any? %>
        <% @images.each do |image| %>
          <div class="GalleryImageContainer">
            <%= link_to rails_public_blob_url(image.variant(:large)), data: { fancybox: 'imageGallery' } do %>
              <%= image_tag(rails_public_blob_url(image.variant(:thumb)), alt: 'ArogyaM wellness center and Sacred Grove', loading: "lazy") %>
            <% end %>
            <% if current_user_admin? %>
              <%= link_to "Delete image", destroy_gallery_path(@gallery, param2: "#{image.id}"), class: "deleteImage btn btn-danger btn-sm", data: {turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <%= image_tag(dev_images('flowers.jpg'), width: 800, data: {fancybox: 'imageGallery'}, alt: 'Sacred Grove gardens', loading: "lazy") %>
      <% end %>

    </div>


  </div>
</section>
