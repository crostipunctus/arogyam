<% set_meta_tags title: 'About',
                 description: 'Learn about ArogyaM Wellness Center at Sacred Grove, Chowdepalli — an initiative by the Satsang Foundation dedicated to Ayurvedic healing and holistic wellness.' %>

<section class="container py-5 mt-5 mb-md-3 mb-lg-4 mb-xxl-5">
  <h1 class="cardHeading packages text-center">About ArogyaM</h1>
  <p class="text-center text-muted mb-5">An initiative by the Satsang Foundation dedicated to Ayurvedic healing and holistic wellness</p>

  <%# Story Section %>
  <div class="row justify-content-center mb-5">
    <div class="col-12 col-lg-10">
      <div class="row g-5 align-items-start">
        <div class="col-12 col-md-6">
          <div class="about-section">
            <h3 class="about-section-heading">Our Story</h3>
            <p class="about-text">
              The seed of the wellness center, ArogyaM, was planted at The Sacred Grove by Sri M in
              June of 2019, and became fully operational on July 3rd, 2022. Its purpose is to offer
              individuals a space to explore and experience health and well-being through the practice
              and study of the ancient traditions of Yoga and Ayurveda.
            </p>
            <p class="about-text">
              ArogyaM follows the belief that everyone is in pursuit of happiness, and that a healthy
              body and calm mind are the prerequisites to fulfilling this pursuit, both in daily life
              and in spiritual practices.
            </p>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="about-section">
            <h3 class="about-section-heading">Our Philosophy</h3>
            <p class="about-text">
              Today's fast-paced lives, filled with processed foods and pollution, can cause a buildup
              of toxins in the body and an overload of sensory input for the mind, leading to various
              diseases and stress. It is important to periodically disconnect from these demands and
              recharge through Yogic and Ayurvedic practices surrounded by nature.
            </p>
            <p class="about-text">
              ArogyaM is located in The Sacred Grove, a three-hour drive from Bangalore, surrounded
              by rolling hills and offering a peaceful, serene environment for reflection and self-discovery.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Personalized Approach Highlight %>
  <div class="row justify-content-center mb-5">
    <div class="col-12 col-lg-10">
      <div class="about-highlight">
        <p class="mb-0">
          At ArogyaM, the traditional approach recognizes that every individual is unique and
          therefore requires personalized treatments. In addition to offering programs for
          detoxification, stress relief, weight management, and women's wellness, ArogyaM also
          provides custom treatment programs tailored to meet the specific health needs of each guest.
        </p>
      </div>
    </div>
  </div>

  <%# Team Section %>
  <div class="row justify-content-center">
    <div class="col-12 col-lg-10">
      <h2 class="cardHeading text-center mb-4">The Team</h2>
      <div class="row g-4 justify-content-center">
        <% team_index.each do |team_member| %>
          <% cache team_member do %>
            <div class="col-12 col-sm-6 col-md-4 text-center">
              <div class="team-card">
                <%= image_tag(rails_public_blob_url(team_member.avatar),
                    class: "team-card-photo",
                    alt: "#{team_member.name} - #{team_member.role} at ArogyaM",
                    loading: "lazy") %>
                <h5 class="team-card-name"><%= team_member.name %></h5>
                <p class="team-card-role"><%= team_member.role %></p>
                <p class="team-card-bio"><%= team_member.content %></p>
                <% if current_user_admin? %>
                  <div class="d-flex justify-content-center gap-2 mt-2">
                    <%= link_to "Edit", edit_team_member_path(team_member), class: "btn btn-outline-primary btn-sm rounded-pill px-3" %>
                    <%= link_to "Remove", team_member_path(team_member), class: "btn btn-outline-danger btn-sm rounded-pill px-3", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</section>

<%= render 'shared/cta_banner' %>
