<% set_meta_tags title: 'About',
                 description: 'Learn about ArogyaM Wellness Center at Sacred Grove, Chowdepalli — an initiative by the Satsang Foundation dedicated to Ayurvedic healing and holistic wellness.' %>

<section class="about-hero-section">
  <div class="container">
    <div class="about-hero-content text-center">
      <p class="about-hero-label">Est. 2022 &middot; Sacred Grove, Chowdepalli</p>
      <h1 class="about-hero-title">ArogyaM</h1>
      <p class="about-hero-subtitle">Where ancient wisdom meets holistic well-being</p>
    </div>
  </div>
</section>

<section class="container py-5 mb-md-3 mb-lg-4 mb-xxl-5">

  <%# Story Section %>
  <div class="row justify-content-center mb-5 pb-lg-3">
    <div class="col-12 col-lg-10">
      <div class="about-story-block">
        <div class="row g-5 align-items-center">
          <div class="col-12 col-md-5">
            <div class="about-decorative-badge">
              <span class="about-badge-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16"><path d="M8 16c3.314 0 6-2.686 6-6a6.003 6.003 0 0 0-3.3-5.36l.145-.117a.5.5 0 0 0-.64-.768l-.16.13A6.003 6.003 0 0 0 8 4c-.68 0-1.34.113-1.955.32l-.205-.166a.5.5 0 1 0-.628.776l.09.073A6.003 6.003 0 0 0 2 10c0 3.314 2.686 6 6 6zM8 5a5 5 0 1 1 0 10A5 5 0 0 1 8 5z"/><path d="M6.5 1a.5.5 0 0 0-.5.5v2a.5.5 0 0 0 1 0v-2a.5.5 0 0 0-.5-.5zm3 0a.5.5 0 0 0-.5.5v2a.5.5 0 0 0 1 0v-2a.5.5 0 0 0-.5-.5zM8 0a.5.5 0 0 0-.5.5v2a.5.5 0 0 0 1 0v-2A.5.5 0 0 0 8 0z"/></svg>
              </span>
              <h3 class="about-badge-title">Our Story</h3>
              <div class="about-badge-line"></div>
            </div>
          </div>
          <div class="col-12 col-md-7">
            <p class="about-story-text">
              The seed of the wellness center, ArogyaM, was planted at The Sacred Grove by Sri M in
              June of 2019, and became fully operational on July 3rd, 2022. Its purpose is to offer
              individuals a space to explore and experience health and well-being through the practice
              and study of the ancient traditions of Yoga and Ayurveda.
            </p>
            <p class="about-story-text mb-0">
              ArogyaM follows the belief that everyone is in pursuit of happiness, and that a healthy
              body and calm mind are the prerequisites to fulfilling this pursuit, both in daily life
              and in spiritual practices.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Philosophy Section %>
  <div class="row justify-content-center mb-5 pb-lg-3">
    <div class="col-12 col-lg-10">
      <div class="about-story-block">
        <div class="row g-5 align-items-center flex-md-row-reverse">
          <div class="col-12 col-md-5">
            <div class="about-decorative-badge">
              <span class="about-badge-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16"><path d="M8.5 2.687c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492V2.687zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783z"/></svg>
              </span>
              <h3 class="about-badge-title">Our Philosophy</h3>
              <div class="about-badge-line"></div>
            </div>
          </div>
          <div class="col-12 col-md-7">
            <p class="about-story-text">
              Today's fast-paced lives, filled with processed foods and pollution, can cause a buildup
              of toxins in the body and an overload of sensory input for the mind, leading to various
              diseases and stress. It is important to periodically disconnect from these demands and
              recharge through Yogic and Ayurvedic practices surrounded by nature.
            </p>
            <p class="about-story-text mb-0">
              ArogyaM is located in The Sacred Grove, a three-hour drive from Bangalore, surrounded
              by rolling hills and offering a peaceful, serene environment for reflection and self-discovery.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Personalized Approach Highlight %>
  <div class="row justify-content-center mb-5 pb-lg-3">
    <div class="col-12 col-lg-10">
      <div class="about-quote-block">
        <div class="about-quote-mark">&ldquo;</div>
        <p class="about-quote-text">
          At ArogyaM, the traditional approach recognizes that every individual is unique and
          therefore requires personalized treatments. In addition to offering programs for
          detoxification, stress relief, weight management, and women's wellness, ArogyaM also
          provides custom treatment programs tailored to meet the specific health needs of each guest.
        </p>
      </div>
    </div>
  </div>

  <%# Team Section %>
  <div class="row justify-content-center">
    <div class="col-12 col-lg-10">
      <div class="text-center mb-5">
        <p class="about-hero-label mb-2">The people behind your wellness</p>
        <h2 class="about-team-heading">Our Team</h2>
      </div>
      <div class="row g-4 justify-content-center">
        <% team_index.each do |team_member| %>
          <% cache team_member do %>
            <div class="col-12 col-sm-6 col-md-4">
              <div class="about-team-card">
                <div class="about-team-photo-wrapper">
                  <%= image_tag(rails_public_blob_url(team_member.avatar.variant(:thumb)),
                      class: "about-team-photo",
                      alt: "#{team_member.name} - #{team_member.role} at ArogyaM",
                      loading: "lazy") %>
                </div>
                <div class="about-team-info">
                  <h5 class="about-team-name"><%= team_member.name %></h5>
                  <p class="about-team-role"><%= team_member.role %></p>
                  <p class="about-team-bio"><%= team_member.content %></p>
                </div>
                <% if current_user_admin? %>
                  <div class="d-flex justify-content-center gap-2 mt-2 pb-3">
                    <%= link_to "Edit", edit_team_member_path(team_member), class: "btn btn-outline-primary btn-sm rounded-pill px-3" %>
                    <%= link_to "Remove", team_member_path(team_member), class: "btn btn-outline-danger btn-sm rounded-pill px-3", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</section>

<%= render 'shared/cta_banner' %>
