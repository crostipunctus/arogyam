<% set_meta_tags title: @package.name,
                 description: @package.short_description.presence || "Learn about the #{@package.name} programme at ArogyaM Wellness Center." %>

<section class="programme-detail">
  <div class="container">
    <header class="programme-detail__header">
      <%= link_to "← All programmes", programmes_path, class: "programme-detail__back", data: { turbo: false } %>
      <% if @package.special? %>
        <p class="mt-4 mb-3"><span class="programme-special-badge">Special programme</span></p>
      <% end %>
      <h1><%= @package.name %></h1>
      <p class="programme-detail__lead"><%= @package.short_description %></p>
    </header>

    <div class="row g-4 g-lg-5 align-items-start">
      <aside class="col-12 col-lg-4 order-lg-2 programme-detail__sidebar" aria-label="Programme booking details">
        <div class="programme-booking">
          <h2>Plan your stay</h2>
          <dl class="programme-booking__facts">
            <% if @package.dates.present? %>
              <div class="programme-booking__dates">
                <dt>Programme dates</dt>
                <dd><%= @package.dates %></dd>
              </div>
            <% end %>
            <div>
              <dt>Duration</dt>
              <dd><%= programme_duration(@package) %></dd>
            </div>
            <div>
              <dt>Programme fee</dt>
              <dd class="programme-booking__price"><%= @package.formatted_cost %></dd>
            </div>
          </dl>
          <%= render "registration_cta", package: @package %>
        </div>
        <% if current_user_admin? %>
          <div class="d-flex flex-wrap gap-3 mt-4">
            <%= link_to "Edit Programme", edit_package_path(@package), class: "small" %>
            <%= link_to "Delete Programme", destroy_package_path(@package), class: "small text-danger", data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this programme?" } %>
          </div>
        <% end %>
      </aside>

      <div class="col-12 col-lg-8 order-lg-1 programme-content">
        <% if @package.package_image.attached? %>
          <%= image_tag rails_public_blob_url(@package.package_image.variant(:hero)), class: "programme-detail__image", alt: "#{@package.name} - Ayurvedic wellness programme at ArogyaM", loading: "lazy" %>
        <% end %>
        <%= render "programme_content", package: @package %>
      </div>
    </div>

    <div class="programme-detail__stories">
      <p class="mb-0">Discover what a stay at ArogyaM can feel like.</p>
      <%= link_to "Read participant stories →", testimonials_path, class: "brand-link" %>
    </div>
  </div>
</section>
