  <% set_meta_tags title: @package.name,
                   description: @package.short_description.presence || "Learn about the #{@package.name} programme at ArogyaM Wellness Center." %>
  <div class="container pt-5 pb-sm-3 mt-5 mb-2 mb-md-3 mb-lg-4 mb-xxl-5">
   <%= link_to "<i class='bi bi-arrow-left-circle'></i>".html_safe, :back, id:"back_to", data: {turbo: false} %>
    <h1 id="packageName" class="text-center"><%= @package.name %></h1>
    <div id="packageTagline"><%= @package.short_description %></div>



    <div class="container-fluid mt-5">
    <div class="row justify-content-center">
      <div class="col-12 col-md-10 col-lg-8 col-xl-6">
        <div class="registration-prompt p-4 rounded-3 mb-4 text-center">
        <% if current_user %>
          <% if !has_profile?(current_user) %>
            <div id="PleaseCreateProfileHeading">
              <i class="bi bi-person-plus fs-1 text-primary mb-3 d-block"></i>
              <p class="text-muted mb-4">Please create or complete your profile to register for a programme</p>
              <%= link_to new_user_profile_path(current_user), 
                  class: "btn btn-outline-primary rounded-pill px-4", 
                  id: "PleaseCreateProfile" do %>
                <i class="bi bi-person-circle me-2"></i>Go to Profile
              <% end %>
            </div>
          <% elsif has_active_registration?(current_user) %>
            <div class="active-registration-notice">
              <i class="bi bi-exclamation-circle fs-1 text-warning mb-3 d-block"></i>
              <p class="text-muted mb-4">Please cancel your current active registration to register for another programme</p>
              <%= link_to registrations_path, 
                  class: "btn btn-outline-warning rounded-pill px-4" do %>
                <i class="bi bi-arrow-right-circle me-2"></i>View My Registrations
              <% end %>
            </div>
          <% else %>
            <i class="bi bi-calendar-check fs-1 text-primary mb-3 d-block"></i>
            <h5 class="mb-3">Ready to Join?</h5>
            <%= link_to new_registration_path(package_id: @package.id), 
                class: "btn btn-outline-primary rounded-pill px-4", 
                id: "registerButton",
                data: {turbo: false, action: "click->profile-checker#checkProfile"} do %>
              <i class="bi bi-arrow-right-circle me-2"></i>Register Now
            <% end %>
          <% end %>
      <% else %>
            <i class="bi bi-box-arrow-in-right fs-1 text-primary mb-3 d-block"></i>
            <p class="text-muted mb-4">Please sign in to register for this batch</p>
            <%= link_to new_user_session_path, 
                class: "btn btn-outline-primary rounded-pill px-4" do %>
              <i class="bi bi-door-open me-2"></i>Sign In
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
    
    <div class="durationCostContainer">
      <div class="packageDuration"><%= "#{@package.duration} days"%></div>
      <div class="packageCost"><%= "Rs. #{@package.cost}" %></div>
      
    </div>
    <div id="package-image" class="package-image">
          <%= package_image(@package) %>
        </div> 
      <div class="packageShow">
        <div class="packageText">
          <% if @package.dates.present? %>
              <h3 class="dates mb-lg-4"><%= "Dates: #{@package.dates}" %></h3>
          <% end %>
          <div id="package" class="package mb-0 mb-md-1 mb-lg-3"><%= @package.content%></div><br>
          <div class="package-titles"><strong>Benefits:</strong></div>
          <span id="package" class="mb-0 mb-md-1 mb-lg-3"><%= @package.benefits%></span><br>
          <div class="package-titles"><strong>Eligibility:</strong></div>
          <span id="package" class="mb-0 mb-md-1 mb-lg-3"><%= @package.eligibility%></span><br>
          <div class="package-titles"><strong>Note:</strong></div>
          <span id="package" class="mb-0 mb-md-1 mb-lg-3"><%= @package.note%></span>
          <% if current_user_admin? %>
            <div class="admin">
              <%= link_to "Edit package", edit_package_path(@package), class: "btn btn-primary btn-sm" %>
            </div>
            <div  class="admin">
              <%= link_to "Delete package", destroy_package_path(@package), class: "btn btn-danger btn-sm", data: {turbo_method: :delete, turbo_confirm: "Are you sure?" }%>
            </div>
          <% end %>
        
        </div>
      </div>
  </div>

<%= render 'shared/testimonials_preview' %>

