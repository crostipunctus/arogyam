<% set_meta_tags title: 'Testimonials',
                 description: 'Read testimonials from guests who experienced Ayurvedic treatments and wellness programmes at ArogyaM Wellness Center.' %>

<%= render "shared/page_header",
           eyebrow: "Testimonials",
           title: "Stories of renewal",
           description: "Guests reflect on their time, care, and healing journeys at ArogyaM." %>

<section class="container page-section testimonials-page">

  <div class="row g-4 justify-content-center">
    <% @testimonials.each do |testimonial| %>
      <div class="col-12 col-md-6">
        <div class="testimonial-card">
          <div class="ratio ratio-16x9">
            <iframe src="https://www.youtube.com/embed/<%= testimonial.youtube_id %>?rel=0"
                    title="<%= testimonial.title.presence || 'ArogyaM patient testimonial' %>"
                    frameborder="0"
                    allowfullscreen
                    loading="lazy"></iframe>
          </div>
          <% if testimonial.title.present? %>
            <div class="testimonial-card-body">
              <h5 class="testimonial-card-title"><%= testimonial.title %></h5>
            </div>
          <% end %>
          <% if current_user_admin? %>
            <div class="testimonial-card-admin">
              <%= link_to "Delete", "testimonials/#{testimonial.id}", class: "btn btn-outline-danger btn-sm rounded-pill px-3", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <% if current_user_admin? %>
    <div class="text-center mt-5">
      <%= link_to 'Add Testimonial', "testimonials/new", class: "btn btn-outline-primary rounded-pill px-4" %>
    </div>
  <% end %>
</section>

<%= render 'shared/cta_banner' %>
