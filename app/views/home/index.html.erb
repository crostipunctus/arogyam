  <%= page_title 'Arogyam: The Wellness Center' %>

  <%# Preload critical background image %>
  <link rel="preload" href="https://d1w11gv0j27jrz.cloudfront.net/pouring2compressed.webp" as="image">

  <div class="cover" style="background-image: url(https://d1w11gv0j27jrz.cloudfront.net/pouring2compressed.webp);">
      <div class="big-logo">
          <%= image_tag(dev_images("big-logo-2.png"), alt: 'big-logo', loading: 'eager', width: '300', height: '150') %>
      </div>
      <div class="newlogo">
          <div class="homeLogo"><%= image_tag(dev_images("symbol.png"), loading: 'eager', width: '100', height: '100') %></div>
          <div class="ayurvedicWellness">WELLNESS CENTER</div>
          <div>Intentional living <br><span class="for">for</span><br> body & mind wellness</div>
          <div class="landingpagetext">Arogyam (noun): <strong>Health</strong>. Derived from "<i>aroga</i>" which means absence of disease. "<i>roga</i>": 
              derived from the Sanskrit root "<i>ruk</i>" or pain.
          </div>
          <%= link_to "See our health programmes", programmes_path, class: "landingBookButton btn btn-outline-primary rounded-pill", data: {turbo: false} %>
      </div>
  </div>
   
<div class="hometextContainer">
 
  <div > 
    <%= render "home_text" %>
    <div class='home_buttons'>
      <%= link_to "Explore programmes", programmes_path, class: "HomePageButton btn btn-outline-primary rounded-pill"%>
      <%= link_to "Online Consultations", online_consultations_path, class: "HomePageButton  btn btn-outline-primary rounded-pill"%>
    </div>
  </div>
</div>

<section class="container py-4 mt-4">
  <div class="gallery-container">  
    <% if gallery_index.images.attached? %>
      <div class="gallery-grid">
        <% gallery_index.images.each do |image| %>
          <div class="gallery-item">
            <%= image_tag(rails_public_blob_url(image), 
                          data: {fancybox: 'imageGallery'}, 
                          alt: 'home-page-gallery',
                          loading: 'lazy') %>
            <% if current_user_admin? %>
              <%= link_to destroy_gallery_path(gallery_index, param2: "#{image.id}"), 
                  class: "delete-gallery-image", 
                  data: {turbo_method: :delete, turbo_confirm: "Are you sure?"} do %>
                <i class="fas fa-times"></i>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= image_tag("https://d1w11gv0j27jrz.cloudfront.net/flowers.jpg", width: 800, data: {fancybox: 'imageGallery'}, alt: 'placeholder-flower') %>
    <% end %>
  </div>
</section>

<section class="arogyam-newsletter-section">
  <div class="arogyam-newsletter-wrapper">
    <div class="arogyam-newsletter-inner">
      <div class="arogyam-newsletter-header">
        <h2>Join Our Community</h2>
        <p>Subscribe to receive wellness tips, event updates, and other insights.</p>
      </div>
      
      <%= form_with(model: NewsletterSubscription.new, 
                    url: newsletter_subscriptions_path, 
                    local: true, 
                    class: "arogyam-newsletter-form") do |form| %>
        <div class="arogyam-newsletter-input-group">
          <%= form.email_field :email, 
              class: "arogyam-newsletter-email", 
              placeholder: "Enter your email address", 
              id: "newsletter",
              required: true %>
          <%= form.submit "Subscribe", 
              class: "arogyam-newsletter-submit", 
              id: "newsletterSubmit" %>
        </div>
        <div class="arogyam-newsletter-recaptcha">
          <div class="g-recaptcha" data-sitekey="<%= Rails.application.credentials.recaptcha_v2[:site_key] %>"></div>
        </div>
      <% end %>
    </div>
  </div>
</section>   

<script src="https://www.google.com/recaptcha/api.js" async defer></script>













          
      



  
  
   

