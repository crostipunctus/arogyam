<script>
  // Improved background image loading strategy
  document.addEventListener('turbo:load', function() {
    const cover = document.getElementById('coverElement');
    if (!cover) return;
    
    // Load high-res background immediately for LCP improvement
    loadHighResBackground(cover);
  });

  function loadHighResBackground(element) {
    const img = new Image();
    img.fetchPriority = 'high';
    img.onload = function() {
      element.style.backgroundImage = 'url(https://d1w11gv0j27jrz.cloudfront.net/pouring2compressed.webp)';
      // Mark the LCP as complete for analytics
      if (window.performance && window.performance.mark) {
        window.performance.mark('lcp-complete');
      }
    };
    img.src = 'https://d1w11gv0j27jrz.cloudfront.net/pouring2compressed.webp';
  }
  
  // Lazy load remaining CSS
  function loadDeferredStyles() {
    const stylesheets = [
      '/assets/application.css'
      // Add any other non-critical stylesheets here
    ];
    
    stylesheets.forEach(href => {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = href;
      document.head.appendChild(link);
    });
  }
  
  // Load remaining styles after page is interactive
  if (window.requestIdleCallback) {
    requestIdleCallback(loadDeferredStyles);
  } else {
    setTimeout(loadDeferredStyles, 3000);
  }
</script>













          
      



  
  
   

