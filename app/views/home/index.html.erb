      position: relative;
      background-size: cover;
      background-position: center;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      align-items: center;
      color: #fff;
      padding-top: 5vh;
    }
    .big-logo, .newlogo {
      text-align: center;
      z-index: 2;
    }
    .big-logo {
      margin-bottom: 1vh;
    }
    .big-logo img {
      max-width: 100%;
      height: auto;
      width: auto;
      min-width: 300px;
    }
    .newlogo {
      margin-top: 0;
    }
    /* Critical font styles - handled by Google Fonts CSS */
    /* Critical Swiper styles */
    .swiper-container {
      margin-left: auto;
      margin-right: auto;
      position: relative;
      overflow: hidden;
      list-style: none;
      padding: 0;
      z-index: 1;
    }
    /* Gallery styles now in _user.scss */
    /* Newsletter section styles */
    .arogyam-newsletter-section {
      background-color: #f6f9fc;
      padding: 3rem 1rem;
    }
    .arogyam-newsletter-wrapper {
      max-width: 700px;
      margin: 0 auto;
      text-align: center;
    }
    .arogyam-newsletter-input-group {
      display: flex;
      gap: 0.75rem;
      max-width: 500px;
      margin: 0 auto;
