  <%# Fonts are loaded via Google Fonts CSS below %>

  <div class="cover" style="background-image: url(https://d1w11gv0j27jrz.cloudfront.net/pouring2compressed.webp);" id="coverElement">
      <div class="big-logo">
          <%= image_tag(dev_images("big-logo-2.png"), alt: 'Arogyam logo', loading: 'eager', fetchpriority: 'high', width: '400', height: '200', decoding: 'async') %>
