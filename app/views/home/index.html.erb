    .arogyam-newsletter-email {
      flex: 1;
      padding: 0.75rem 1rem;
      border: 1px solid #e3e9ef;
      border-radius: 0.5rem;
      outline: none;
    }
    .arogyam-newsletter-submit {
      padding: 0.75rem 1.5rem;
      background-color: #414833;
      color: white;
      border: none;
      border-radius: 0.5rem;
      cursor: pointer;
    }
    /* Add other critical styles here */
  </style>

  <%# Preload critical background image with proper priority %>
  <link rel="preload" href="https://d1w11gv0j27jrz.cloudfront.net/pouring2compressed.webp" as="image" fetchpriority="high" type="image/webp">
  
  <%# Fonts are loaded via Google Fonts CSS below %>

  <div class="cover" style="background-image: url(https://d1w11gv0j27jrz.cloudfront.net/pouring2compressed.webp);" id="coverElement">
      <div class="big-logo">
          <%= image_tag(dev_images("big-logo-2.png"), alt: 'Arogyam logo', loading: 'eager', fetchpriority: 'high', width: '400', height: '200', decoding: 'async') %>
      </div>
      <div class="newlogo">
          <div class="homeLogo"><%= image_tag(dev_images("symbol.png"), alt: 'Arogyam symbol', loading: 'eager', fetchpriority: 'high', width: '100', height: '100', decoding: 'async') %></div>
          <div class="ayurvedicWellness">WELLNESS CENTER</div>
          <div>Intentional living <br><span class="for">for</span><br> body & mind wellness</div>
          <div class="landingpagetext">Arogyam (noun): <strong>Health</strong>. Derived from "<i>aroga</i>" which means absence of disease. "<i>roga</i>": 
              derived from the Sanskrit root "<i>ruk</i>" or pain.
          </div>
          <%= link_to "See our health programmes", programmes_path, class: "landingBookButton btn btn-outline-primary rounded-pill", data: {turbo: false} %>
      </div>
  </div>
   
<div class="hometextContainer">
 
  <div > 
    <%= render "home_text" %>
    <div class='home_buttons'>
      <%= link_to "Explore programmes", programmes_path, class: "HomePageButton btn btn-outline-primary rounded-pill"%>
    </div>
  </div>
</div>

<section class="container py-4 mt-4">
  <div class="gallery-container">  
      <% if gallery_index && gallery_index.images.attached? %>
      <div class="gallery-grid">
        <% gallery_index.images.each do |image| %>
          <div class="gallery-item">
            <%= link_to rails_public_blob_url(image.variant(:large)), data: { fancybox: 'imageGallery' } do %>
              <%= image_tag(rails_public_blob_url(image.variant(:thumb)),
                            alt: 'ArogyaM wellness center at Sacred Grove',
                            loading: 'lazy',
                            decoding: 'async') %>
            <% end %>
            <% if current_user_admin? %>
              <%= link_to destroy_gallery_path(gallery_index, param2: "#{image.id}"), 
                  class: "delete-gallery-image", 
                  data: {turbo_method: :delete, turbo_confirm: "Are you sure?"} do %>
                <i class="fas fa-times"></i>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= image_tag("https://d1w11gv0j27jrz.cloudfront.net/flowers.jpg", 
                    loading: 'lazy',
                    decoding: 'async',
                    data: {fancybox: 'imageGallery'}, 
                    alt: 'Sacred Grove gardens at ArogyaM',
                    style: 'max-width: 100%; height: auto;') %>
    <% end %>
  </div>
</section>

<%= render 'shared/testimonials_preview' %>

<section class="arogyam-newsletter-section">
  <div class="arogyam-newsletter-wrapper">
    <div id="newsletter-form-container">
      <div class="arogyam-newsletter-header">
        <h2>Join Our Community</h2>
        <p>Subscribe to receive wellness tips, event updates, and other insights.</p>
      </div>

      <%= render "newsletter_subscriptions/form" %>
    </div>
  </div>
</section>   














          
      



  
  
   

