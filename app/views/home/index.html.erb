<div class="hometextContainer">
 
  <div > 
    <%= render "home_text" %>
    <div class='home_buttons'>
      <%= link_to "Explore programmes", programmes_path, class: "HomePageButton btn btn-outline-primary rounded-pill"%>
    </div>
  </div>
</div>

<% if @featured_packages.present? %>
  <section class="container py-5 home-featured-programmes">
    <div class="text-center mb-5">
      <p class="home-featured-label">Begin Your Journey</p>
      <h2 class="home-featured-title">Featured Programmes</h2>
      <p class="home-featured-subtitle">Healing journeys rooted in Ayurveda and yoga at the Sacred Grove</p>
    </div>

    <div class="row g-4 justify-content-center">
      <% @featured_packages.each do |package| %>
        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
          <div class="programme-card h-100">
            <div class="programme-card-inner h-100">
              <%= link_to programme_path(package), class: "text-decoration-none text-reset", data: { turbo: false } do %>
                <div class="programme-card-image">
                  <% if package.package_image.attached? %>
                    <%= image_tag(rails_public_blob_url(package.package_image.variant(:card)), alt: "#{package.name} - Ayurvedic wellness programme at ArogyaM", loading: "lazy") %>
                  <% else %>
                    <%= image_tag(dev_images('flowers.jpg'), alt: "#{package.name} - Ayurvedic wellness programme at ArogyaM", loading: "lazy") %>
                  <% end %>
                </div>
                <div class="programme-card-body">
                  <h5 class="programme-card-title"><%= package.name %></h5>
                  <p class="programme-card-description"><%= package.short_description %></p>
                  <div class="programme-card-meta">
                    <span><%= package.duration %></span>
                    <span class="programme-card-divider"></span>
                    <span>Rs. <%= package.cost %></span>
                  </div>
                </div>
              <% end %>
              <div class="programme-card-actions">
                <%= link_to "Book now", new_registration_path(package_id: package.id), class: "btn btn-primary rounded-pill w-100", data: { turbo: false } %>
                <%= link_to "Learn more", programme_path(package), class: "btn btn-link rounded-pill w-100 mt-1", data: { turbo: false } %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="text-center mt-5">
      <%= link_to "See all programmes", programmes_path, class: "btn btn-outline-primary rounded-pill px-4", data: { turbo: false } %>
    </div>
  </section>
<% end %>

<section class="container py-4 mt-4">
  <div class="gallery-container">
      <% if gallery_index && gallery_index.images.attached? %>
      <div class="gallery-grid">
        <% gallery_index.images.each do |image| %>
          <div class="gallery-item">
            <%= link_to rails_public_blob_url(image.variant(:large)), data: { fancybox: 'imageGallery' } do %>
              <%= image_tag(rails_public_blob_url(image.variant(:thumb)),
                            alt: 'ArogyaM wellness center at Sacred Grove',
                            loading: 'lazy',
                            decoding: 'async') %>
            <% end %>
            <% if current_user_admin? %>
              <%= link_to destroy_gallery_path(gallery_index, param2: "#{image.id}"), 
                  class: "delete-gallery-image", 
                  data: {turbo_method: :delete, turbo_confirm: "Are you sure?"} do %>
                <i class="fas fa-times"></i>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= image_tag("https://d1w11gv0j27jrz.cloudfront.net/flowers.jpg", 
                    loading: 'lazy',
                    decoding: 'async',
                    data: {fancybox: 'imageGallery'}, 
                    alt: 'Sacred Grove gardens at ArogyaM',
                    style: 'max-width: 100%; height: auto;') %>
    <% end %>
  </div>
</section>

<%= render 'shared/testimonials_preview' %>

<section class="arogyam-newsletter-section">
  <div class="arogyam-newsletter-wrapper">
    <div id="newsletter-form-container">
      <div class="arogyam-newsletter-header">
        <h2>Join Our Community</h2>
        <p>Subscribe to receive wellness tips, event updates, and other insights.</p>
      </div>

      <%= render "newsletter_subscriptions/form" %>
    </div>
  </div>
</section>   














          
      



  
  
   

