<% set_meta_tags title: 'Ayurvedic Wellness Center',
                 description: 'ArogyaM is an Ayurvedic wellness center at Sacred Grove, Chowdepalli. Discover holistic health programmes, yoga, Panchakarma treatments, and healing retreats by Satsang Foundation.',
                 keywords: 'Ayurveda, yoga, wellness center, Panchakarma, Sacred Grove, Chowdepalli, Satsang Foundation, Sri M, health retreat, holistic healing' %>

<link rel="preload" href="https://d1w11gv0j27jrz.cloudfront.net/pouring2compressed.webp" as="image" fetchpriority="high" type="image/webp">

<section class="home-hero" style="--hero-image: url('https://d1w11gv0j27jrz.cloudfront.net/pouring2compressed.webp')">
  <div class="container home-hero__container">
    <div class="home-hero__content">
      <p class="eyebrow home-hero__eyebrow">Ayurveda · Yoga · Sacred Grove</p>
      <h1>Return to your<br><em>natural balance.</em></h1>
      <p class="home-hero__lead">Personalised healing journeys rooted in the enduring wisdom of Ayurveda and Yoga.</p>
      <div class="home-hero__actions">
        <%= link_to "Explore health programmes", programmes_path, class: "btn btn-primary btn-lg" %>
        <%= link_to "Discover ArogyaM", about_path, class: "home-hero__text-link" %>
      </div>
    </div>

    <aside class="home-hero__definition" aria-label="Meaning of ArogyaM">
      <span class="home-hero__definition-word">ārogyam</span>
      <span class="home-hero__definition-type">noun · Sanskrit</span>
      <p>A state of health; freedom from disease and the pain it causes.</p>
    </aside>
  </div>
  <div class="home-hero__location">Chowdepalli, Andhra Pradesh</div>
</section>

<section class="home-intro section-space">
  <div class="container">
    <div class="row g-5 align-items-start">
      <div class="col-12 col-lg-5">
        <p class="eyebrow">A considered path to wellbeing</p>
        <h2 class="display-heading">Care for the whole person.</h2>
      </div>
      <div class="col-12 col-lg-6 offset-lg-1">
        <p class="home-intro__lead">At ArogyaM, we nurture complete wellbeing through the timeless disciplines of <strong>Ayurveda</strong> and <strong>Yoga</strong>.</p>
        <p>Each journey brings together traditional Ayurvedic treatments, Asana, Pranayama, nourishing food, and time for quiet reflection—guided by the understanding that every person is unique.</p>
        <%= link_to "Read about our philosophy", about_path, class: "brand-link" %>
      </div>
    </div>

    <div class="home-pillars">
      <article>
        <span>01</span>
        <h3>Personalised</h3>
        <p>Programmes are shaped around your constitution, health needs, and stage of life.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Traditional</h3>
        <p>Classical Ayurvedic knowledge and Yogic practice form the foundation of our care.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Restorative</h3>
        <p>A peaceful natural setting creates the time and space required for meaningful renewal.</p>
      </article>
    </div>
  </div>
</section>

<% if @featured_packages.present? %>
  <section class="home-programmes section-space">
    <div class="container">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">Begin your journey</p>
          <h2 class="display-heading">Featured programmes</h2>
        </div>
        <%= link_to "View every programme", programmes_path, class: "brand-link d-none d-md-inline-flex" %>
      </div>

      <div class="row g-4">
        <% @featured_packages.each_with_index do |package, index| %>
          <div class="col-12 col-md-6 <%= index.zero? ? 'col-xl-6' : 'col-xl-3' %>">
            <article class="programme-card programme-card--home h-100">
              <%= link_to programme_path(package), class: "programme-card__link", data: { turbo: false } do %>
                <div class="programme-card-image">
                  <% if package.package_image.attached? %>
                    <%= image_tag(rails_public_blob_url(package.package_image.variant(:card)), alt: "#{package.name} - Ayurvedic wellness programme at ArogyaM", loading: "lazy") %>
                  <% else %>
                    <%= image_tag(dev_images('flowers.jpg'), alt: "#{package.name} - Ayurvedic wellness programme at ArogyaM", loading: "lazy") %>
                  <% end %>
                  <span class="programme-card__number"><%= format('%02d', index + 1) %></span>
                </div>
                <div class="programme-card-body">
                  <p class="programme-card__meta"><%= package.duration %> days · Rs. <%= package.cost %></p>
                  <h3 class="programme-card-title"><%= package.name %></h3>
                  <p class="programme-card-description"><%= package.short_description %></p>
                  <span class="programme-card__discover">Discover programme <span aria-hidden="true">→</span></span>
                </div>
              <% end %>
            </article>
          </div>
        <% end %>
      </div>

      <%= link_to "View every programme", programmes_path, class: "btn btn-outline-primary w-100 d-md-none mt-4" %>
    </div>
  </section>
<% end %>

<section class="home-place section-space">
  <div class="container">
    <div class="home-place__frame">
      <div class="home-place__image">
        <%= image_tag(dev_images('acco4.jpg'), alt: 'The courtyard and gardens at ArogyaM, Sacred Grove', loading: 'lazy') %>
      </div>
      <div class="home-place__content">
        <p class="eyebrow">The Sacred Grove</p>
        <h2 class="display-heading">Space to slow down.<br>Nature to return to.</h2>
        <p>ArogyaM is surrounded by rolling hills, gardens, and quiet walking paths. Our rooms gather around a courtyard where Dhanwantri is enshrined beneath a forty-year-old tamarind tree.</p>
        <div class="home-place__facts">
          <div><strong>9</strong><span>guest rooms</span></div>
          <div><strong>3 hr</strong><span>from Bengaluru airport</span></div>
        </div>
        <%= link_to "Explore your stay", accommodation_path, class: "brand-link" %>
      </div>
    </div>
  </div>
</section>

<% if gallery_index && gallery_index.images.attached? %>
  <section class="home-gallery section-space">
    <div class="container">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">Life at ArogyaM</p>
          <h2 class="display-heading">From the grove</h2>
        </div>
        <%= link_to "Visit the gallery", gallery_index_path, class: "brand-link" %>
      </div>
      <div class="home-gallery__grid">
        <% gallery_index.images.first(5).each_with_index do |gallery_image, index| %>
          <%= link_to rails_public_blob_url(gallery_image.variant(:large)), class: "home-gallery__item home-gallery__item--#{index + 1}", data: { fancybox: 'homeGallery' } do %>
            <%= image_tag(rails_public_blob_url(gallery_image.variant(:thumb)), alt: 'Life and landscape at ArogyaM wellness center', loading: 'lazy', decoding: 'async') %>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<%= render 'shared/testimonials_preview' %>

<section class="newsletter-section">
  <div class="container">
    <div class="newsletter-section__inner">
      <div>
        <p class="eyebrow">Notes for mindful living</p>
        <h2>Seasonal wisdom, from our grove to your inbox.</h2>
        <p>Receive programme news, Ayurvedic practices, and reflections from Sacred Grove.</p>
      </div>
      <div id="newsletter-form-container">
        <%= render "newsletter_subscriptions/form" %>
      </div>
    </div>
  </div>
</section>
