<section class="testimonials-preview section-space">
  <div class="container">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Guest experiences</p>
        <h2 class="display-heading">In their own words</h2>
      </div>
      <%= link_to "Hear more stories", testimonials_path, class: "brand-link d-none d-md-inline-flex" %>
    </div>
    <div class="row justify-content-center g-4 testimonials-preview__grid">
      <% testimonials_preview.each do |testimonial| %>
        <div class="col-12 col-md-6">
          <div class="ratio ratio-16x9 testimonials-preview__video">
            <iframe src="https://www.youtube.com/embed/<%= testimonial.youtube_id %>?rel=0"
                    title="<%= testimonial.title.presence || 'ArogyaM patient testimonial' %>"
                    frameborder="0"
                    allowfullscreen
                    loading="lazy"></iframe>
          </div>
        </div>
      <% end %>
    </div>
    <%= link_to "Hear more stories", testimonials_path, class: "btn btn-outline-primary w-100 d-md-none mt-4" %>
  </div>
</section>
