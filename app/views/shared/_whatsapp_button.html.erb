<% if site_settings.whatsapp_enabled? %>
  <%= link_to site_settings.whatsapp_chat_url,
              class: "whatsapp-float",
              target: "_blank",
              rel: "noopener noreferrer",
              aria: { label: "Chat with ArogyaM on WhatsApp" },
              title: "Chat on WhatsApp",
              data: {
                controller: "analytics",
                action: "click->analytics#track",
                analytics_event_name_value: "whatsapp_click",
                analytics_params_value: { event_category: "engagement", event_label: "floating_button" }.to_json
              } do %>
    <i class="fab fa-whatsapp" aria-hidden="true"></i>
    <span class="whatsapp-float-label">Chat with us</span>
  <% end %>
<% end %>
